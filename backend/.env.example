# Copy to .env and adjust. Never commit .env.
DATABASE_URL=mysql+asyncmy://privatefind:privatefind@localhost:3306/privatefind
SECRET_KEY=change-me-to-a-long-random-string

# AI_PROVIDER: mock, claude, or qwen
AI_PROVIDER=mock
# Disabled by default. See README.md: local reporting requires ALL four explicit settings,
# including DATABASE_URL=sqlite+aiosqlite:///:memory:. Never point this mode at MySQL/team data.
APP_ENV=production
ALLOW_MOCK_AI_REPORTS=false
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# OpenAI-compatible vLLM base URL including /v1. An empty model uses /models.
QWEN_BASE_URL=
QWEN_API_KEY=
QWEN_MODEL=
QWEN_TIMEOUT=25
# Enable in a local demo to print successful analyses, including private attributes.
QWEN_LOG_ANALYSIS=false

STORAGE_DIR=storage/photos
