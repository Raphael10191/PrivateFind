                "value": "application/json"
              }
            ],
            "description": "Role: public. See frontend-integration.md. Cookies are managed by Postman after login.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"display_name\": \"Test owner\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const isJson = pm.response.headers.get('Content-Type')?.includes('application/json');",
                  "if (pm.response.code >= 200 && pm.response.code < 300 && isJson) {",
                  "  const b = pm.response.json();",
                  "  if (b.pickup_code) pm.collectionVariables.set('pickup_code', b.pickup_code);",
