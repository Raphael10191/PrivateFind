{
  "info": {
    "name": "PrivateFind API",
    "description": "Manual integration collection. Select a photo before deposit; set device_key manually. Change email/password and login as the seeded admin for admin requests. Device validation defaults to deposit_code; substitute pickup_code for pickup. State defaults to occupied=true; send false after pickup. This is not an unattended collection-runner scenario.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "email",
      "value": "owner@example.com"
    },
    {
      "key": "password",
      "value": "secret123"
    },
    {
      "key": "locker_code",
      "value": "L1"
    },
    {
      "key": "item_id",
      "value": "1"
    },
    {
      "key": "report_id",
      "value": "1"
    },
    {
      "key": "claim_id",
      "value": "1"
    },
    {
      "key": "photo_id",
      "value": "1"
    },
    {
      "key": "compartment",
      "value": "1"
