# Copy this file to .env and enter your own local database data.
# .env is in .gitignore and is never pushed to GitHub.
DATABASE_URL=mysql+pymysql://pf:pf_pass@localhost:3306/privatefind

# Secret for hashing the locker codes. Use any long random text and never change it later.
SECRET_KEY=change-me-to-a-long-random-text

# Private folder for the item photos (relative to the project folder)
UPLOAD_DIR=uploads

# Key of the ESP32 (sent in the header X-Device-Key). The seed script stores its hash.
DEVICE_KEY=dev-locker-key

# Max. requests per IP and minute for the web API
RATE_LIMIT_PER_MINUTE=30

# true as soon as the embedding API (services/embeddings.py) works
SEMANTIC_ENABLED=false
